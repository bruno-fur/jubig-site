# Site
NEXT_PUBLIC_SITE_URL=https://jubig-site.vercel.app
NEXT_PUBLIC_WHATSAPP_DIRETORIA=5545999999999
NEXT_PUBLIC_INSTAGRAM=jubig.oficial

# Supabase (Settings > API Keys > aba "Publishable and secret API keys")
# O nome ANON_KEY é o convencional e ficou: o valor pode ser tanto a chave
# publishable nova (sb_publishable_...) quanto a anon antiga (eyJ...).
# SERVICE_ROLE_KEY recebe a secret (sb_secret_...). Ela ignora a RLS inteira —
# nunca numa variável NEXT_PUBLIC_, que o Next embute no bundle do navegador.
NEXT_PUBLIC_SUPABASE_URL=https://upjutvwwpyllrgzikqxj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail — SMTP do Gmail com senha de app (precisa de 2FA ligado na conta).
# A senha de app tem 16 letras; pode colar com ou sem os espaços.
GMAIL_USUARIO=jubig.ofc@gmail.com
GMAIL_SENHA_APP=
EMAIL_NOME_REMETENTE=JUBIG

# Lembretes automáticos: sem isto a rota /api/cron/lembretes recusa tudo.
# Qualquer texto longo e aleatório; a Vercel envia no header Authorization.
CRON_SECRET=
